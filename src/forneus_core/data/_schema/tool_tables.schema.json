{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forneus.wiki/schema/tool_tables.schema.json",
  "title": "Forneus level-table dataset",
  "description": "Game data for a tool whose entities level up along a cost/power curve.",
  "type": "object",
  "required": ["schema_version", "tool", "cost_unit", "captured_at", "categories", "display_order"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "tool": { "type": "string", "minLength": 1 },
    "cost_unit": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "game_version": { "type": "string" },
    "display_order": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["display_name", "effectiveness_rate", "tier", "levels"],
        "additionalProperties": false,
        "properties": {
          "display_name": { "type": "string", "minLength": 1 },
          "effectiveness_rate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "tier": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "minItems": 2, "maxItems": 2,
            "description": "[captured_tier, max_tier] - unequal values mean provisional data."
          },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["level", "bracket_cost", "raw_power"],
              "additionalProperties": false,
              "properties": {
                "level": { "type": ["integer", "string"] },
                "bracket_cost": { "type": "integer", "minimum": 0 },
                "raw_power": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
