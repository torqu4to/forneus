# Base URL of the Forneus API.
#
# PUBLIC_ is Astro's prefix for variables that are baked into client JS — this
# one ends up in the browser bundle, so it must never hold a secret.
#
# Unset, the client falls back to same-origin "/api", which is what you want
# when a proxy serves both from one hostname.
#
# Local development against a local API:
PUBLIC_API_URL=http://127.0.0.1:8000/api
#
# Production (Railway gives the service a *.up.railway.app hostname; swap it
# for api.forneus.wiki once the custom domain is attached):
# PUBLIC_API_URL=https://api.forneus.wiki
