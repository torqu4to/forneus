# Base URL of the Forneus API.
#
# Unused in the current architecture: the optimizer runs in the browser and
# there is no API to call. Kept because `src/forneus_core/api/` still exists
# and Phase 3 may revive it. Leave it unset.
# PUBLIC_API_URL=http://127.0.0.1:8000/api

# The public origin of this build. Drives canonical URLs, hreflang and
# og:url, and decides whether the build is indexable. Unset means
# production (https://forneus.wiki); anything else is marked noindex.
# PUBLIC_SITE_URL=https://forneus.brunohenriquecosta2014.workers.dev

# Supabase — accounts and saved profiles.
#
# PUBLIC_ means these end up in the browser bundle. That is correct for these
# two and ONLY these two: the anon key identifies the project and authorizes
# nothing by itself. Row Level Security (supabase/001_profiles.sql) is what
# protects the data.
#
# Never put the service_role key here, or anywhere in this repository. It
# bypasses RLS entirely.
#
# With both unset, accounts are simply switched off and profiles live in the
# browser — the site works either way.
PUBLIC_SUPABASE_URL=https://kbnuedoybxgcvtgilpxo.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtibnVlZG95YnhnY3Z0Z2lscHhvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk1MjE2NjgsImV4cCI6MjEwNTA5NzY2OH0.OVbzriF6JtroP1t2wPTh_gTzVd25_cb6s0sK4RVxKRg
