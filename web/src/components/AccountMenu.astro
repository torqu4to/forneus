---
/**
 * Sign-in state in the header.
 *
 * Renders the signed-out shape at build time and lets the client correct it,
 * because a static page cannot know who is looking. The swap is done by
 * toggling `hidden`, never by rebuilding the markup, so there is no flash of
 * the wrong state on a fast connection.
 */
import { useTranslations, type Locale } from '../i18n/utils';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<div class="acct" data-account>
  <a class="acct__link" href={`/${locale}/conta/`} data-account-signedout>{t('nav.signin')}</a>

  <a class="acct__user" href={`/${locale}/conta/`} data-account-signedin hidden>
    <img class="acct__avatar" data-account-avatar alt="" width="20" height="20" hidden />
    <span data-account-name></span>
  </a>
</div>


<script>
  /* The header renders signed-out at build time — a static page cannot know
     who is looking. This corrects it once the session is known, by toggling
     `hidden` rather than rebuilding markup, so nothing jumps. */
  import { currentAccount, onAccountChange, accountsEnabled }
    from '../lib/profiles/auth.ts';

  if (accountsEnabled) {
    const root = document.querySelector<HTMLElement>('[data-account]');
    if (root) {
      const signedOut = root.querySelector<HTMLElement>('[data-account-signedout]')!;
      const signedIn = root.querySelector<HTMLElement>('[data-account-signedin]')!;
      const nameEl = root.querySelector<HTMLElement>('[data-account-name]')!;
      const avatarEl = root.querySelector<HTMLImageElement>('[data-account-avatar]')!;

      const render = (account: Awaited<ReturnType<typeof currentAccount>>) => {
        signedOut.hidden = Boolean(account);
        signedIn.hidden = !account;
        if (!account) {
          // Leave nothing behind: a stale name in a hidden element is one CSS
          // rule away from being visible again.
          nameEl.textContent = '';
          avatarEl.removeAttribute('src');
          avatarEl.hidden = true;
          return;
        }
        nameEl.textContent = account.name;
        if (account.avatarUrl) {
          avatarEl.src = account.avatarUrl;
          avatarEl.hidden = false;
        } else {
          avatarEl.removeAttribute('src');
          avatarEl.hidden = true;
        }
      };

      render(await currentAccount());
      onAccountChange(render);
    }
  }
</script>

<style>
  .acct { display: flex; align-items: center; }
  .acct__link, .acct__user {
    display: flex; align-items: center; gap: var(--space-3);
    font-size: var(--size-body-s); color: var(--text-default);
  }
  .acct__link:hover, .acct__user:hover { color: var(--accent); }
  .acct__avatar { border-radius: 50%; }
  @media (max-width: 720px), (pointer: coarse) {
    .acct__link, .acct__user { min-height: 44px; min-width: 44px; justify-content: center; }
  }
</style>
