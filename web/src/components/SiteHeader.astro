---
import Brand from './Brand.astro';
import { switchLocalePath, LOCALES, type Locale } from '../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const here = Astro.url.pathname;
---

<header class="hdr">
  <div class="hdr__inner">
    <a href={`/${locale}/`} class="hdr__brand" aria-label={`Forneus, ${locale === 'pt' ? 'início' : 'home'}`}>
      <Brand />
    </a>
    <nav class="hdr__lang" aria-label={locale === 'pt' ? 'Idioma' : 'Language'}>
      {LOCALES.map((code) => (
        <a
          href={switchLocalePath(here, code)}
          class:list={['hdr__locale', { 'is-active': code === locale }]}
          aria-current={code === locale ? 'page' : undefined}
          lang={code}
        >{code.toUpperCase()}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: relative;
    z-index: var(--z-header);
    background: #101114;
    color: #f5f5f6;
  }

  .hdr__inner {
    display: flex;
    width: 100%;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    margin: 0 auto;
    padding-inline: clamp(20px, 4vw, 56px);
  }

  .hdr__brand {
    display: inline-flex;
    align-items: center;
    color: #f5f5f6;
  }

  .hdr__brand :global(.brandmark) {
    color: inherit;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.015em;
  }

  .hdr__brand :global(.brandmark svg) { display: none; }

  .hdr__lang {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hdr__locale {
    display: inline-flex;
    min-width: 32px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid transparent;
    color: #a6a7ad;
    font: 500 14px/1 var(--font-body);
    transition: color 160ms ease, border-color 160ms ease;
  }

  .hdr__locale:hover,
  .hdr__locale.is-active {
    color: #f5f5f6;
  }

  .hdr__locale.is-active { border-color: #f5f5f6; }

  .hdr__locale:focus-visible {
    outline: 2px solid #f5f5f6;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hdr__locale { transition: none; }
  }
</style>
