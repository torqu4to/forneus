---
import AccountMenu from './AccountMenu.astro';
import Brand from './Brand.astro';
import { tools } from '../data/tools';
import { useTranslations, switchLocalePath, LOCALES, type Locale } from '../i18n/utils';

interface Props { locale: Locale; active?: string }
const { locale, active } = Astro.props;
const t = useTranslations(locale);
const here = Astro.url.pathname;
---
<header class="hdr">
  <nav id="site-navigation" class="hdr__nav" aria-label={t('nav.tools')}>
    <a href={`/${locale}/`} class="brand">
      <Brand />
    </a>
    <button class="hdr__menu" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="site-navigation" data-menu>
      <img src="/assets/forneus-menu-mark.png" width="1280" height="1280" alt="" aria-hidden="true" />
    </button>
    {tools.map((tool) => (
      <a
        href={tool.status === 'available' ? `/${locale}/ferramentas/${tool.name}/` : undefined}
        class:list={['hdr__link', { 'is-active': active === tool.name, 'is-planned': tool.status === 'planned' }]}
        aria-current={active === tool.name ? 'page' : undefined}
      >{t(tool.navKey)}{tool.beta && <> <span class="hdr__beta">{t('tool.beta')}</span></>}</a>
    ))}
  </nav>

  <div class="hdr__end">
    <div class="lang" role="group" aria-label="Idioma / Language">
      {LOCALES.map((code) => (
        <a
          href={switchLocalePath(here, code)}
          class:list={['lang__opt', { 'is-active': code === locale }]}
          aria-current={code === locale ? 'true' : undefined}
          lang={code}
        >{code.toUpperCase()}</a>
      ))}
    </div>
    <AccountMenu locale={locale} />
  </div>
</header>

<style>
  .hdr {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-8);
    height: var(--nav-h); padding: 0 var(--page-pad);
    background: var(--bg-raised);
    border-bottom: var(--border) solid var(--line-hard);
  }
  .hdr__nav { display: flex; align-items: center; gap: var(--space-9); min-width: 0; }
  .hdr__menu { display: none; }
  .brand { display: flex; align-items: center; color: var(--accent); }
  .brand:hover { color: var(--accent-hover); }
  .brand__logo { width: 220px; height: 48px; object-fit: contain; object-position: left center; transform: scale(1.35); transform-origin: left center; }
  .hdr__link {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-size: var(--size-body-s); color: var(--text-faint);
    text-transform: uppercase; white-space: nowrap;
  }
  .hdr__link:hover { color: var(--text-strong); }
  .hdr__link.is-active {
    color: var(--text-strong); font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--accent);
    padding-block: calc((var(--nav-h) - 20px) / 2);
  }
  /* A tool with no page yet is not a link and must not look like one. */
  .hdr__link.is-planned { color: var(--text-disabled); cursor: default; }
  .hdr__link.is-planned:hover { color: var(--text-disabled); }
  .hdr__beta {
    padding: 1px 3px;
    color: var(--accent); border: 1px solid currentColor;
    font: 600 .54rem var(--font-mono); letter-spacing: .06em;
    line-height: 1;
  }

  .hdr__end {
    display: flex; align-items: center; gap: var(--space-6);
    /* The bar spans the window, but this block lines up with the page
       content instead of hugging the window edge. The percentage resolves
       against the body's content box, so a visible scrollbar does not shift
       it — `100vw` would, by the scrollbar's width. max() keeps it put below
       --page-max, where there is no gutter to reclaim. */
    margin-inline-end: max(0px, calc((100% - var(--page-max)) / 2));
  }
  .lang { display: flex; gap: var(--space-2); }
  .lang__opt {
    font-family: var(--font-mono); font-size: var(--size-label);
    color: var(--text-faint);
  }
  .lang__opt:hover { color: var(--text-strong); }
  @media (max-width: 720px), (pointer: coarse) {
    .lang__opt { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; }
    .hdr { height: auto; min-height: var(--nav-h); flex-wrap: wrap; }
  }
  .lang__opt.is-active { color: var(--text-strong); }
  .hdr__signin { font-size: var(--size-body-s); color: var(--text-default); }

  @media (max-width: 720px) {
    .hdr { height: auto; min-height: var(--nav-h); flex-wrap: wrap; padding-block: var(--space-2); }
    .hdr__nav { flex: 1; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }
    .hdr__menu { display: inline-grid; place-items: center; width: 44px; height: 44px; padding: 7px; color: var(--text-default); background: transparent; border: 0; cursor: pointer; }
    .hdr__menu img { display: block; width: 30px; height: 30px; object-fit: contain; transition: transform 180ms ease; }
    .hdr__menu[aria-expanded="true"] img { transform: rotate(45deg) scale(.9); }
    .hdr__link { display: none; flex-basis: 100%; min-height: 44px; }
    .hdr__nav[data-open="true"] .hdr__link { display: inline-flex; }
    .hdr__link.is-active { padding-block: var(--space-2); }
    .brand__logo { width: 180px; height: 42px; transform: scale(1.15); }
  }
</style>

<script>
  const menu = document.querySelector<HTMLButtonElement>('[data-menu]');
  const navigation = document.getElementById('site-navigation');
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') === 'true';
    menu.setAttribute('aria-expanded', String(!open));
    menu.setAttribute('aria-label', open ? 'Abrir menu' : 'Fechar menu');
    navigation?.toggleAttribute('data-open', !open);
  });
</script>
