---
import type { Locale } from '../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<footer class="ftr">
  <span>© 2026 Forneus</span>
  <a href={`/${locale}/`}>forneus.wiki</a>
</footer>

<style>
  .ftr {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px clamp(20px, 4vw, 56px);
    border-top: 1px solid #2a2c31;
    background: #101114;
    color: #85878e;
    font: 400 11px/1.4 var(--font-body);
  }

  .ftr a { color: inherit; }
  .ftr a:hover { color: #f5f5f6; }

  @media (max-width: 420px) {
    .ftr { min-height: 44px; }
  }
</style>
