---
import { availableTools } from '../data/tools';
import { useTranslations, type Locale } from '../i18n/utils';
import Brand from './Brand.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<footer class="ftr">
  <div class="ftr__inner">
    <div class="ftr__about">
      <a href={`/${locale}/`} aria-label={`Forneus, ${locale === 'pt' ? 'início' : 'home'}`}><Brand /></a>
      <p>{t('footer.description')}</p>
      <small>{t('footer.independent')}</small>
    </div>
    <div class="ftr__links">
      <h2>{t('footer.tools')}</h2>
      {availableTools.map((tool) => <a href={`/${locale}/ferramentas/${tool.name}/`}>{t(tool.navKey)}<span aria-hidden="true">↗</span></a>)}
      <p>{t('footer.check')}</p>
    </div>
  </div>
  <div class="ftr__bottom"><span>© 2026 Forneus</span><span>{t('footer.disclaimer')}</span><a href={`/${locale}/`}>forneus.wiki</a></div>
</footer>

<style>
  .ftr { position:relative; isolation:isolate; overflow:hidden; background:#0e1715; color:#f1eee2; font-family:var(--font-body); }
  .ftr::before { content:''; position:absolute; z-index:-2; inset:0; background:url('/assets/footer-forneus.png') center/cover no-repeat; opacity:.35; }
  .ftr::after { content:''; position:absolute; z-index:-1; inset:0; background:#0e1715b8; }
  .ftr__inner { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(220px,.7fr); gap:clamp(40px,9vw,140px); max-width:var(--page-max); margin:auto; padding:clamp(70px,9vw,130px) var(--page-pad) 65px; }
  .ftr__about :global(.brandmark) { color:#f1eee2; font-size:clamp(32px,4vw,56px); }
  .ftr__about :global(.brandmark svg) { width:48px; height:55px; }
  .ftr__about p { max-width:28ch; margin:28px 0; font-size:clamp(20px,2.3vw,31px); line-height:1.3; color:#f1eee2; }
  .ftr__about small { display:block; max-width:44ch; color:#c4d5c8; font-size:14px; line-height:1.5; }
  .ftr__links { display:flex; flex-direction:column; align-items:stretch; }
  .ftr__links h2 { margin:0 0 22px; color:#f1eee2; font:600 25px var(--font-body); letter-spacing:0; }
  .ftr__links a { display:flex; justify-content:space-between; gap:20px; padding:14px 0; color:#f1eee2; font-size:17px; font-weight:600; }
  .ftr__links a:hover { color:#75d9b7; }
  .ftr__links a span { font-size:22px; }
  .ftr__links p { max-width:30ch; margin-top:25px; color:#c4d5c8; font-size:15px; line-height:1.5; }
  .ftr__bottom { display:flex; justify-content:space-between; gap:25px; max-width:var(--page-max); margin:auto; padding:24px var(--page-pad); background:#0a1411; color:#c4d5c8; font-size:14px; }
  .ftr__bottom a { color:#75d9b7; }
  @media (max-width:700px) { .ftr__inner { grid-template-columns:1fr; gap:45px; padding-block:70px 45px; } .ftr__bottom { flex-direction:column; gap:8px; } }
</style>
