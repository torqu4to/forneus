---
interface Item {
  label: string;
  href?: string;
  current?: boolean;
}

interface Props {
  items: Item[];
  label: string;
}

const { items, label } = Astro.props;
---

<nav class="animated-menu" aria-label={label}>
  <ul>
    {items.map((item) => (
      <li>
        {item.href ? (
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>
            <span class="roll" aria-label={item.label}>
              <span class="roll__line roll__top" aria-hidden="true">
                {item.label.split('').map((character, index) => {
                  const delay = `${(Math.abs(index - (item.label.length - 1) / 2) * 0.035).toFixed(3)}s`;
                  return <span class="roll__character" style={`--delay:${delay}`}>{character}</span>;
                })}
              </span>
              <span class="roll__line roll__bottom" aria-hidden="true">
                {item.label.split('').map((character, index) => {
                  const delay = `${(Math.abs(index - (item.label.length - 1) / 2) * 0.035).toFixed(3)}s`;
                  return <span class="roll__character" style={`--delay:${delay}`}>{character}</span>;
                })}
              </span>
            </span>
          </a>
        ) : (
          <span class="animated-menu__disabled" aria-disabled="true">
            <span class="roll" aria-label={item.label}>
              <span class="roll__line roll__top" aria-hidden="true">
                {item.label.split('').map((character, index) => {
                  const delay = `${(Math.abs(index - (item.label.length - 1) / 2) * 0.035).toFixed(3)}s`;
                  return <span class="roll__character" style={`--delay:${delay}`}>{character}</span>;
                })}
              </span>
              <span class="roll__line roll__bottom" aria-hidden="true">
                {item.label.split('').map((character, index) => {
                  const delay = `${(Math.abs(index - (item.label.length - 1) / 2) * 0.035).toFixed(3)}s`;
                  return <span class="roll__character" style={`--delay:${delay}`}>{character}</span>;
                })}
              </span>
            </span>
          </span>
        )}
      </li>
    ))}
  </ul>
</nav>

<style is:global>
  .animated-menu {
    display: flex;
    width: 100%;
    min-height: min(76vh, 720px);
    min-height: min(76svh, 720px);
    flex: 1;
    align-items: center;
    justify-content: center;
    padding: 28px;
  }

  .animated-menu ul {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 0;
    padding: 12px 28px;
    list-style: none;
  }

  .animated-menu li { display: flex; overflow: visible; }

  .animated-menu a,
  .animated-menu__disabled {
    display: block;
    color: #f5f5f6;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(36px, 5vw, 48px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.85;
    text-decoration: none;
    text-transform: uppercase;
  }

  .animated-menu a:focus-visible {
    color: #f5f5f6;
    outline: 2px solid #f5f5f6;
    outline-offset: 8px;
  }

  .roll {
    position: relative;
    display: inline-block;
    overflow: hidden;
    line-height: 0.85;
    vertical-align: top;
  }

  .roll__line {
    display: block;
    white-space: nowrap;
  }

  .roll__bottom {
    position: absolute;
    inset: 0;
  }

  .roll__character {
    display: inline-block;
    transform: translate3d(0, 0, 0);
    transition: transform 300ms ease-in-out;
    transition-delay: var(--delay);
  }

  .roll__bottom .roll__character {
    transform: translate3d(0, 100%, 0);
  }

  .animated-menu a:hover .roll__top .roll__character,
  .animated-menu a:focus-visible .roll__top .roll__character,
  .animated-menu li:hover .animated-menu__disabled .roll__top .roll__character {
    transform: translate3d(0, -100%, 0);
  }

  .animated-menu a:hover .roll__bottom .roll__character,
  .animated-menu a:focus-visible .roll__bottom .roll__character,
  .animated-menu li:hover .animated-menu__disabled .roll__bottom .roll__character {
    transform: translate3d(0, 0, 0);
  }

  @media (max-width: 600px) {
    .animated-menu { min-height: min(72svh, 640px); padding-inline: 16px; }
    .animated-menu ul { padding-inline: 12px; }
    .animated-menu a,
    .animated-menu__disabled { font-size: clamp(32px, 9vw, 42px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .roll__character { transition-duration: 0.01ms; transition-delay: 0s; }
  }
</style>
