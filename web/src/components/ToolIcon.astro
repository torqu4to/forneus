---
/**
 * Per-tool icon.
 *
 * Each tool needs its own mark: in a vertical list three identical icons
 * carry no information and the eye stops using them. All three are drawn on
 * the same 24px grid with the same 1.4 stroke so they read as one set, and
 * they inherit `currentColor` so an available and a planned tool tint from
 * the same markup.
 *
 * A name with no icon falls through to nothing rather than to a wrong icon —
 * a missing glyph is obvious, a wrong one is not.
 */
interface Props { name: string; size?: number; class?: string }
const { name, size = 28, class: className } = Astro.props;

const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.4,
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
  'aria-hidden': 'true',
  focusable: 'false',
  class: className,
};
---
{name === 'amigatos' && (
  <svg {...common}>
    {/* catpal: ears and face */}
    <path d="M4.5 9.5 6 4l4 3.2h4L18 4l1.5 5.5"></path>
    <path d="M4.5 9.5c0 5.2 3.4 9 7.5 9s7.5-3.8 7.5-9"></path>
    <path d="M9.5 12h.01"></path>
    <path d="M14.5 12h.01"></path>
  </svg>
)}
{name === 'fantasmas' && (
  <svg {...common}>
    {/* ghost: domed head, scalloped hem */}
    <path d="M6 20V9.5a6 6 0 0 1 12 0V20l-2-1.6-2 1.6-2-1.6-2 1.6-2-1.6z"></path>
    <path d="M9.5 10.5h.01"></path>
    <path d="M14.5 10.5h.01"></path>
  </svg>
)}
{name === 'florais' && (
  <svg {...common}>
    {/* floral guardian: bloom over a stem */}
    <path d="M12 11.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"></path>
    <path d="M12 5.5C12 3.6 10.7 2.5 9 2.5S6.2 4 6.8 5.8"></path>
    <path d="M12 5.5c0-1.9 1.3-3 3-3s2.8 1.5 2.2 3.3"></path>
    <path d="M12 11.5V21"></path>
    <path d="M12 15.5c-2.2 0-4-1.4-4.6-3"></path>
  </svg>
)}
