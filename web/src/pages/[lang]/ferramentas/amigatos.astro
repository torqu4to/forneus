---
import Site from '../../../layouts/Site.astro';
import { solve } from '../../../lib/solver/index.ts';
import { EXAMPLE_TEAM, EXAMPLE_BUDGET } from '../../../data/example-team';
import { groupRows, categoryClass, categoryRoman, categoryRomanClass, isProvisional } from '../../../lib/rows.ts';
import { dataset } from '../../../lib/solver/dataset.ts';
import { useTranslations, formatNumber, LOCALES, type Locale } from '../../../i18n/utils';
import { LOCALE_TAG } from '../../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const n = (value: number) => formatNumber(value, locale);

/* Rendered at build time so the page paints and crawls with a real result.
   The moment the visitor calculates, the client swaps in the API's answer
   using the same shape — see the script at the bottom. */
/* Solved at build time so the page paints and crawls with a real result. */
const result = solve(EXAMPLE_TEAM, EXAMPLE_BUDGET);
const { meta, totals, notices } = result;
const rows = groupRows(result.rows, meta.display_order);

const categories = meta.display_order.map((key) => ({
  key,
  count: meta.counts[key] ?? 0,
  tier: meta.data_tiers[key],
  rate: Math.round((meta.effectiveness_rates[key] ?? 0) * 100),
  label: result.rows.find((row) => row.category === key)?.display_name ?? key,
  levels: dataset.categories[key].levels.map((row) => row.level),
}));

const teamSize = Object.values(meta.counts).reduce((sum, value) => sum + value, 0);
const messages = notices.map((notice) => t(notice.key as never, notice.params));
---
<Site
  locale={locale}
  active="amigatos"
  title={t('tool.amigatos.title')}
  description={t('tool.amigatos.description')}
>
  <header class="tool-head">
    <div class="tool-head__content">
      <p class="tool-head__eyebrow"><span class="tool-head__line"></span> Tree of Savior Neo <span class="tool-head__dot">/</span> {locale === 'pt' ? 'Ferramenta de evolução' : 'Upgrade tool'}</p>
      <h1>{t('tool.amigatos.title')}</h1>
      <p class="tool-head__intro">{t('tool.amigatos.description')}</p>
      <div class="tool-head__actions">
        <a class="tool-head__start" href="#solver">{locale === 'pt' ? 'Montar minha equipe' : 'Build my team'} <span aria-hidden="true">↗</span></a>
        <a class="tool-head__guide" href={`/${locale}/ferramentas/amigatos/como-usar/`}>{t('how.open.guide')} <span aria-hidden="true">→</span></a>
        <a class="tool-head__guide" href={`/${locale}/ferramentas/amigatos/progressao/`}>{locale === 'pt' ? 'Consultar custos e progressão' : 'Explore costs and progression'} <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="tool-head__art" aria-hidden="true">
      <span class="tool-head__orbit tool-head__orbit--outer"></span>
      <span class="tool-head__orbit tool-head__orbit--inner"></span>
      <img src="/assets/characters/catpal.png" alt="" width="1200" height="1310" fetchpriority="high" />
      <span class="tool-head__art-label">ASSIST <strong>01 / 01</strong></span>
    </div>
  </header>

  <aside class="fx-notice" id="notice" data-level="warning">
    <span class="fx-notice__tag" id="notice-tag">{t('notice.tag')}</span>
    <span class="fx-notice__text" id="notice-text">{messages.join(' · ')}</span>
  </aside>

  <form class="work" id="solver" novalidate
    data-locale={locale}
    data-locale-tag={LOCALE_TAG[locale]}
    data-max-team={meta.max_team_size}>

    <section class="col col--setup" aria-labelledby="team-heading">
      <div class="section-label"><span>01</span><span>{locale === 'pt' ? 'CONFIGURAÇÃO' : 'SETUP'}</span></div>
      <div class="block">
        <div class="block__head">
          <h2 class="fx-label">{t('form.profile')}</h2>
          <span class="fx-meta"><span id="team-size">{teamSize}</span> / {meta.max_team_size}</span>
        </div>
        <div class="profile">
          <button
            class="fx-btn fx-btn--ghost profile__toggle"
            type="button"
            id="saved-teams-toggle"
            aria-controls="saved-teams"
            aria-expanded="false"
          >{t('profile.heading')}</button>
          <div class="profile-picker" id="saved-teams" hidden>
            <p class="hint profile-picker__storage" data-profile-storage>{t('auth.local_only')}</p>
            <button type="button" class="fx-btn fx-btn--ghost" data-profile-new>{t('profile.new')}</button>
            <p class="hint" data-profile-empty tabindex="-1">{t('profile.none')}</p>
            <ul class="profile-picker__list" data-profile-list hidden></ul>
            <div class="profile-editor" data-profile-editor hidden>
              <label class="fx-label" for="profile-name">{t('profile.name')}</label>
              <input
                class="fx-field" id="profile-name" data-profile-name type="text" maxlength="60"
                placeholder={t('profile.name.placeholder')}
              />
              <div class="profile-editor__head">
                <span class="fx-meta" data-profile-count></span>
                <button type="button" class="fx-btn fx-btn--ghost" data-profile-add>{t('profile.add_catpal')}</button>
              </div>
              <p class="hint" data-profile-team-empty>{t('profile.empty_team')}</p>
              <ul class="profile-editor__rows" data-profile-rows></ul>
              <p class="hint" data-profile-full hidden>{t('profile.full', { max: meta.max_team_size })}</p>
              <div class="profile-editor__actions">
                <button type="button" class="fx-btn" data-profile-save>{t('profile.save')}</button>
                <button type="button" class="fx-btn fx-btn--ghost" data-profile-cancel>{t('profile.cancel')}</button>
              </div>
            </div>
            <p class="hint" role="status" aria-live="polite" data-profile-status></p>
          </div>
        </div>
        <p class="hint">{t('form.profile.help')}</p>
      </div>

      <div class="block">
        <h2 id="team-heading" class="fx-label">{t('form.team')}</h2>
        <div class="rows">
          {categories.map((cat) => (
            <div class="row">
              <label class="row__label" for={`count-${cat.key}`}>
                <span>{cat.label}</span>
                <span class="fx-tier" data-provisional={String(cat.tier[0] !== cat.tier[1])}>
                  {cat.tier[0]}/{cat.tier[1]} · {t('form.effectiveness', { rate: cat.rate })}
                </span>
              </label>
              <input
                class="fx-field row__field" id={`count-${cat.key}`} name={cat.key}
                data-count={cat.key} type="number" inputmode="numeric"
                min="0" max={meta.max_team_size} step="1" value={cat.count}
              />
            </div>
          ))}
        </div>

        <div class="budget">
          <div class="budget__heading">
            <span class="jelly-icon" aria-hidden="true"></span>
            <div>
              <label class="fx-label budget__label" for="total_jelly">{t('form.budget')}</label>
              <span class="budget__unit">{t('form.budget.unit')}</span>
            </div>
          </div>
          <input
            class="fx-field budget__field" id="total_jelly" name="total_jelly"
            type="number" inputmode="numeric" min="0" step="1"
            value={totals.budget} aria-describedby="budget-help"
          />
          <p class="hint budget__help" id="budget-help"><strong>{t('form.budget.help')}</strong></p>
        </div>

        <button type="submit" class="fx-btn" id="calculate">{t('form.submit')}</button>
        <p class="hint" id="status" role="status" aria-live="polite"></p>
      </div>
    </section>

    <section class="col col--wide" aria-labelledby="result-heading">
      <div class="result-head">
        <span class="result-head__index">02 / {locale === 'pt' ? 'RESULTADO' : 'RESULT'}</span>
        <h2 id="result-heading">{t('result.heading')}</h2>
        <p>{locale === 'pt' ? 'A melhor distribuição possível para os recursos da sua equipe.' : 'The best possible allocation for your team’s resources.'}</p>
      </div>

      <div class="fx-stats">
        <div class="fx-stat fx-stat--primary">
          <span class="fx-meta">{t('result.power')}</span>
          <span class="fx-stat__value" id="total-power">{n(totals.effective_power)}</span>
        </div>
        <div class="fx-stat">
          <span class="fx-meta">{t('result.spent')}</span>
          <span class="fx-stat__value" id="total-spent">{n(totals.spent)}</span>
        </div>
        <div class="fx-stat">
          <span class="fx-meta">{t('result.leftover')}</span>
          <span class="fx-stat__value" id="total-leftover">{n(totals.leftover)}</span>
        </div>
      </div>

      <p class="table-hint">{locale === 'pt' ? 'Deslize a tabela para ver todas as colunas →' : 'Scroll the table to see every column →'}</p>
      <div class="table-scroll" tabindex="0" role="region" aria-label={t('result.heading')}><table class="fx-table">
        <caption class="visually-hidden">{t('result.heading')}</caption>
        <thead>
          <tr>
            <th scope="col">{t('result.col.entity')}</th>
            <th scope="col" data-align="end">{t('result.col.tier')}</th>
            <th scope="col" data-align="end">{t('result.col.level')}</th>
            <th scope="col" data-align="end">{t('result.col.cost')}</th>
            <th scope="col" data-align="end">{t('result.col.power')}</th>
          </tr>
        </thead>
        <tbody id="allocations">
          {rows.map((row) => (
            <tr>
              <td class={categoryClass(row.category)}>
                <span class:list={['cat-roman', categoryRomanClass(row.category)]} aria-label={`Tier ${categoryRoman(row.category)}`}>{categoryRoman(row.category)}</span>
                {row.display_name}
                {isProvisional(row) && (
                  <span class="fx-tier" data-provisional="true"> {row.tier[0]}/{row.tier[1]}</span>
                )}
                {row.count > 1 && <span class="fx-count"> ×{row.count}</span>}
              </td>
              <td class="fx-num" data-align="end">6</td>
              <td class="fx-num" data-align="end">{row.level}</td>
              <td class="fx-num cost" data-align="end">{n(row.cost)}</td>
              <td class="fx-num fx-value" data-align="end">{n(row.effective_power)}</td>
            </tr>
          ))}
        </tbody>
      </table></div>

      <p class="hint">{t('result.grouped')} {t('result.costnote')}</p>
      <p class="result-disclaimer" role="note">{t('result.disclaimer')}</p>
    </section>

    <aside class="col col--actions">
      <div class="section-label"><span>03</span><span>{locale === 'pt' ? 'LEVAR COM VOCÊ' : 'TAKE IT WITH YOU'}</span></div>
      <div class="block">
        <h2 class="fx-label">{t('export.heading')}</h2>
        <div class="exports">
          {/* Disabled until a calculation of THIS page's own has succeeded:
              the build-time result is an example, not the visitor's numbers. */}
          <button type="button" class="fx-btn fx-btn--ghost" data-export="csv" disabled>CSV</button>
          <button type="button" class="fx-btn fx-btn--ghost" data-export="json" disabled>JSON</button>
        </div>
      </div>

      <div class="block">
        <h2 class="fx-label">{t('share.heading')}</h2>
        <p class="hint">{t('share.help')}</p>
        <button type="button" class="fx-btn fx-btn--ghost" id="share-team">{t('share.button')}</button>
        <p class="hint" id="share-status" role="status" aria-live="polite"></p>
      </div>

    </aside>

  </form>

  <script type="application/json" id="calculator-profile-levels" is:inline set:html={JSON.stringify(
    Object.fromEntries(categories.map((category) => [category.key, category.levels]))
  )}></script>
</Site>

<style>
  .tool-head {
    position: relative; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(340px, .9fr);
    min-height: 360px; overflow: hidden; isolation: isolate;
    background: var(--bg-panel); border-bottom: 1px solid var(--line-hard);
  }
  .tool-head::before {
    content: ''; position: absolute; inset: 0; z-index: -1; opacity: .38;
    background: linear-gradient(115deg, var(--bg-panel) 15%, var(--bg-chrome) 100%);
  }
  .tool-head__content { position: relative; z-index: 2; padding: clamp(32px, 5vw, 72px) 24px clamp(36px, 4vw, 56px) clamp(24px, 5vw, 72px); }
  .tool-head__eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; color: var(--accent); font: 600 11px var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
  .tool-head__line { width: 26px; height: 1px; background: currentColor; }
  .tool-head__dot { color: var(--text-faint); }
  .tool-head h1 { max-width: 760px; font-size: clamp(48px, 6vw, 88px); line-height: .94; letter-spacing: .005em; text-transform: uppercase; }
  .tool-head__intro { max-width: 470px; margin-top: 22px; color: var(--text-muted); font-size: 16px; line-height: 1.55; }
  .tool-head__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 22px; margin-top: 30px; }
  .tool-head__start { display: inline-flex; align-items: center; justify-content: space-between; gap: 32px; min-height: 46px; padding: 0 16px; background: var(--accent); color: var(--accent-ink); font: 700 16px var(--font-display); letter-spacing: .035em; text-transform: uppercase; }
  .tool-head__start:hover { background: var(--accent-hover); color: var(--accent-ink); }
  .tool-head__guide { display: inline-flex; gap: 10px; align-items: center; color: var(--text-strong); font: 600 13px var(--font-body); text-decoration: underline; text-underline-offset: 5px; }
  .tool-head__guide:hover { color: var(--accent); }
  .tool-head__art { position: relative; min-width: 0; overflow: hidden; background: radial-gradient(circle at 50% 46%, var(--bg-chrome), var(--bg-panel) 70%); }
  .tool-head__orbit { position: absolute; left: 50%; top: 51%; transform: translate(-50%, -50%); border: 1px solid var(--line-control); border-radius: 50%; opacity: .56; }
  .tool-head__orbit--outer { width: 540px; height: 540px; }
  .tool-head__orbit--inner { width: 380px; height: 380px; }
  .tool-head__art img { position: absolute; z-index: 1; left: 50%; bottom: -135px; width: min(560px, 108%); height: auto; transform: translateX(-50%); filter: drop-shadow(0 20px 30px var(--bg-page)); }
  .tool-head__art-label { position: absolute; right: 26px; bottom: 20px; z-index: 2; display: flex; gap: 14px; color: var(--text-faint); font: 11px var(--font-mono); letter-spacing: .14em; }
  .tool-head__art-label strong { color: var(--accent); font-weight: 500; }
  @media (max-width: 760px) {
    .tool-head { display: flex; flex-direction: column; min-height: 0; }
    .tool-head__content { padding: 32px 24px 26px; }
    .tool-head h1 { font-size: clamp(48px, 12vw, 72px); }
    .tool-head__intro { margin-top: 16px; }
    .tool-head__actions { margin-top: 24px; gap: 16px; }
    .tool-head__art { height: 250px; }
    .tool-head__art img { width: 330px; bottom: -145px; }
    .tool-head__orbit--outer { width: 360px; height: 360px; }
    .tool-head__orbit--inner { width: 240px; height: 240px; }
  }
</style>

<script>
  /* The solver runs HERE, in the visitor's browser.

     There is no API call and no server: the worst reachable case measures
     ~0.8 s on this machine and a typical team ~0.09 s, and the result is the
     same one the Python core produces — `web/test/solver.test.ts` checks that
     against fixtures generated by Python itself.

     The page is still useful before this script loads: the build already
     rendered a complete example result. */
  import { solve, ToolError } from '../../../lib/solver/index.ts';
  import { formatCsv, formatJson } from '../../../lib/exports.ts';
  import { groupRows, categoryClass, categoryRoman, categoryRomanClass, isProvisional } from '../../../lib/rows.ts';
  import { useTranslations, formatNumber, type Locale } from '../../../i18n/utils';
  import { ProfileManager } from '../../../lib/profiles/manager.ts';
  import { emptyProfile, newId, type Profile, type SavedCatpal } from '../../../lib/profiles/types.ts';

  const form = document.getElementById('solver') as HTMLFormElement;
  const locale = form.dataset.locale as Locale;
  const localeTag = form.dataset.localeTag!;
  const maxTeam = Number(form.dataset.maxTeam);

  const t = useTranslations(locale);
  const fmt = (value: number) => formatNumber(value, locale);

  const status = document.getElementById('status')!;
  const button = document.getElementById('calculate') as HTMLButtonElement;
  const notice = document.getElementById('notice')!;
  const noticeTag = document.getElementById('notice-tag')!;
  const noticeText = document.getElementById('notice-text')!;
  const tbody = document.getElementById('allocations')!;
  const teamSizeOut = document.getElementById('team-size')!;
  const exportButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-export]')];
  const countInputs = [...document.querySelectorAll<HTMLInputElement>('[data-count]')];
  const jellyInput = document.getElementById('total_jelly') as HTMLInputElement;
  const shareButton = document.getElementById('share-team') as HTMLButtonElement;
  const shareStatus = document.getElementById('share-status')!;
  const savedTeamsToggle = document.getElementById('saved-teams-toggle') as HTMLButtonElement;
  const savedTeams = document.getElementById('saved-teams')!;
  const profileList = savedTeams.querySelector<HTMLElement>('[data-profile-list]')!;
  const profileEmpty = savedTeams.querySelector<HTMLElement>('[data-profile-empty]')!;
  const profileStorage = savedTeams.querySelector<HTMLElement>('[data-profile-storage]')!;
  const profileStatus = savedTeams.querySelector<HTMLElement>('[data-profile-status]')!;
  const profileNew = savedTeams.querySelector<HTMLButtonElement>('[data-profile-new]')!;
  const profileEditor = savedTeams.querySelector<HTMLElement>('[data-profile-editor]')!;
  const profileName = savedTeams.querySelector<HTMLInputElement>('[data-profile-name]')!;
  const profileCount = savedTeams.querySelector<HTMLElement>('[data-profile-count]')!;
  const profileRows = savedTeams.querySelector<HTMLElement>('[data-profile-rows]')!;
  const profileTeamEmpty = savedTeams.querySelector<HTMLElement>('[data-profile-team-empty]')!;
  const profileFull = savedTeams.querySelector<HTMLElement>('[data-profile-full]')!;
  const profileAdd = savedTeams.querySelector<HTMLButtonElement>('[data-profile-add]')!;
  const profileSave = savedTeams.querySelector<HTMLButtonElement>('[data-profile-save]')!;
  const profileCancel = savedTeams.querySelector<HTMLButtonElement>('[data-profile-cancel]')!;

  type ProfileLevel = SavedCatpal['current_level'];
  interface ProfileRow { type: string; level: ProfileLevel; qty: number }
  const profileLevels: Record<string, ProfileLevel[]> = JSON.parse(
    document.getElementById('calculator-profile-levels')!.textContent!,
  );
  const profileTypes = Object.keys(profileLevels);
  const profileLabels = new Map(countInputs.map((input) => [
    input.dataset.count!,
    document.querySelector<HTMLLabelElement>(`label[for="${input.id}"] span`)?.textContent ?? input.dataset.count!,
  ]));
  let profileDraft: Profile | null = null;
  let profileEditorRows: ProfileRow[] = [];

  let downloads: { csv: string; json: string } | null = null;
  function clearFieldErrors() {
    for (const input of [...countInputs, jellyInput]) {
      input.removeAttribute('aria-invalid');
      const ids = (input.getAttribute('aria-describedby') ?? '').split(' ').filter((id) => id && id !== 'status');
      if (ids.length) input.setAttribute('aria-describedby', ids.join(' '));
      else input.removeAttribute('aria-describedby');
    }
    status.textContent = '';
  }
  function focusFieldError(error: ToolError) {
    const field = error.key.startsWith('error.jelly.') ? jellyInput
      : error.key === 'error.team.too_large' ? countInputs.find((input) => Number(input.value) > 0)
      : error.key === 'error.counts.range' ? countInputs.find((input) => !input.validity.valid)
      : undefined;
    if (!field) return;
    status.textContent = t(error.key as never, error.params);
    field.setAttribute('aria-invalid', 'true');
    field.setAttribute('aria-describedby', `${field.getAttribute('aria-describedby') ?? ''} status`.trim());
    field.focus();
  }

  function showNotice(level: 'warning' | 'error', messages: string[]) {
    notice.hidden = messages.length === 0;
    notice.classList.toggle('fx-notice--danger', level === 'error');
    notice.setAttribute('role', level === 'error' ? 'alert' : 'status');
    noticeTag.textContent = level === 'error' ? t('notice.tag.error') : t('notice.tag');
    noticeText.textContent = messages.join(' · ');
  }

  function cell(text: string, className: string) {
    const td = document.createElement('td');
    td.className = className;
    td.dataset.align = 'end';
    td.textContent = text;
    return td;
  }

  function renderRows(rows: Parameters<typeof groupRows>[0], displayOrder: string[]) {
    tbody.replaceChildren(...groupRows(rows, displayOrder).map((row) => {
      const tr = document.createElement('tr');

      const name = document.createElement('td');
      name.className = categoryClass(row.category);
      const roman = document.createElement('span');
      roman.className = `cat-roman ${categoryRomanClass(row.category)}`;
      roman.setAttribute('aria-label', `Tier ${categoryRoman(row.category)}`);
      roman.textContent = categoryRoman(row.category);
      name.append(roman);
      name.append(row.display_name);
      if (isProvisional(row)) {
        const tier = document.createElement('span');
        tier.className = 'fx-tier';
        tier.dataset.provisional = 'true';
        tier.textContent = ` ${row.tier[0]}/${row.tier[1]}`;
        name.append(tier);
      }
      if (row.count > 1) {
        const count = document.createElement('span');
        count.className = 'fx-count';
        count.textContent = ` ×${row.count}`;
        name.append(count);
      }
      tr.append(
        name,
        cell('6', 'fx-num'),
        // "Max" is a level NAME, not a number — it must not reach Intl.
        cell(typeof row.level === 'number' ? fmt(row.level) : String(row.level), 'fx-num'),
        cell(fmt(row.cost), 'fx-num cost'),
        cell(fmt(row.effective_power), 'fx-num fx-value'),
      );
      return tr;
    }));
  }

  function readForm() {
    const counts: Record<string, number> = {};
    for (const input of countInputs) {
      counts[input.dataset.count!] = Math.trunc(Number(input.value)) || 0;
    }
    return { counts, totalJelly: Math.trunc(Number(jellyInput.value)) || 0 };
  }

  function encodeShare(data: ReturnType<typeof readForm>) {
    const payload = JSON.stringify({ c: data.counts, j: data.totalJelly });
    return btoa(payload).replaceAll('+', '-').replaceAll('/', '_').replaceAll('=', '');
  }

  function decodeShare(value: string) {
    const padded = value.replaceAll('-', '+').replaceAll('_', '/') + '='.repeat((4 - value.length % 4) % 4);
    const parsed = JSON.parse(atob(padded)) as { c?: Record<string, unknown>; j?: unknown };
    if (!parsed.c || typeof parsed.j !== 'number' || !Number.isInteger(parsed.j) || parsed.j < 0) return null;
    const counts: Record<string, number> = {};
    for (const input of countInputs) {
      const value = parsed.c[input.dataset.count!];
      if (typeof value !== 'number' || !Number.isInteger(value) || value < 0) return null;
      counts[input.dataset.count!] = value;
    }
    return { counts, totalJelly: parsed.j };
  }

  function loadSharedTeam() {
    const value = new URLSearchParams(location.hash.slice(1)).get('team');
    if (!value) return;
    try {
      const shared = decodeShare(value);
      if (!shared) return;
      for (const input of countInputs) input.value = String(shared.counts[input.dataset.count!]);
      jellyInput.value = String(shared.totalJelly);
      updateTeamSize();
      status.textContent = t('share.loaded');
    } catch { /* Ignore malformed links and leave the example untouched. */ }
  }

  function updateTeamSize() {
    const total = countInputs.reduce(
      (sum, input) => sum + (Math.trunc(Number(input.value)) || 0), 0);
    teamSizeOut.textContent = fmt(total);
    teamSizeOut.parentElement?.classList.toggle('is-over', total > maxTeam);
  }

  function loadProfile(profile: Profile) {
    const counts = new Map<string, number>();
    for (const catpal of profile.catpals) {
      counts.set(catpal.catpal_type, (counts.get(catpal.catpal_type) ?? 0) + 1);
    }
    for (const input of countInputs) {
      input.value = String(counts.get(input.dataset.count!) ?? 0);
    }
    markStale();
    profileStatus.textContent = t('profile.loaded', { name: profile.name || t('profile.new') });
  }

  function renderProfiles(profiles: Profile[]) {
    profileEmpty.hidden = profiles.length > 0;
    profileList.hidden = profiles.length === 0;
    profileList.replaceChildren(...profiles.map((profile) => {
      const item = document.createElement('li');
      const choose = document.createElement('button');
      choose.type = 'button';

      const name = document.createElement('span');
      name.textContent = profile.name || t('profile.new');
      const count = document.createElement('span');
      count.className = 'profile-picker__count';
      count.textContent = t('profile.count', { count: profile.catpals.length, max: maxTeam });

      choose.append(name, count);
      choose.addEventListener('click', () => loadProfile(profile));
      item.append(choose);
      return item;
    }));
  }

  function profileTotal() {
    return profileEditorRows.reduce((sum, row) => sum + row.qty, 0);
  }

  function renderProfileEditor() {
    const total = profileTotal();
    profileCount.textContent = t('profile.count', { count: total, max: maxTeam });
    profileTeamEmpty.hidden = total > 0;
    profileFull.hidden = total < maxTeam;
    profileAdd.disabled = total >= maxTeam;
    profileSave.disabled = total === 0;

    profileRows.replaceChildren(...profileEditorRows.map((row, index) => {
      const item = document.createElement('li');
      item.className = 'profile-editor__row';

      const qty = document.createElement('input');
      qty.className = 'fx-field profile-editor__qty';
      qty.type = 'number';
      qty.inputMode = 'numeric';
      qty.min = '1';
      qty.max = String(row.qty + maxTeam - total);
      qty.value = String(row.qty);
      qty.setAttribute('aria-label', t('profile.qty'));

      const type = document.createElement('select');
      type.className = 'fx-field';
      type.setAttribute('aria-label', t('result.col.entity'));
      type.replaceChildren(...profileTypes.map((key) => {
        const option = document.createElement('option');
        option.value = key;
        option.textContent = profileLabels.get(key) ?? key;
        option.selected = key === row.type;
        return option;
      }));

      const level = document.createElement('select');
      level.className = 'fx-field';
      level.setAttribute('aria-label', t('profile.catpal_level'));
      level.replaceChildren(...profileLevels[row.type].map((value) => {
        const option = document.createElement('option');
        option.value = String(value);
        option.textContent = String(value);
        option.selected = String(value) === String(row.level);
        return option;
      }));

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'fx-btn fx-btn--ghost profile-editor__remove';
      remove.textContent = '×';
      remove.setAttribute('aria-label', t('profile.remove_catpal'));

      qty.addEventListener('change', () => {
        const wanted = Math.floor(Number(qty.value));
        if (!Number.isFinite(wanted) || wanted < 1) profileEditorRows.splice(index, 1);
        else profileEditorRows[index].qty = Math.min(wanted, row.qty + maxTeam - total);
        renderProfileEditor();
      });
      type.addEventListener('change', () => {
        row.type = type.value;
        row.level = profileLevels[type.value][0];
        renderProfileEditor();
      });
      level.addEventListener('change', () => {
        row.level = level.value === 'Max' ? 'Max' : Number(level.value);
      });
      remove.addEventListener('click', () => {
        profileEditorRows.splice(index, 1);
        renderProfileEditor();
      });

      item.append(qty, type, level, remove);
      return item;
    }));
  }

  function openProfileEditor() {
    profileDraft = emptyProfile('');
    profileEditorRows = [];
    profileName.value = '';
    profileStatus.textContent = '';
    profileEditor.hidden = false;
    renderProfileEditor();
    profileName.focus();
  }

  profileNew.addEventListener('click', openProfileEditor);
  profileCancel.addEventListener('click', () => {
    profileDraft = null;
    profileEditorRows = [];
    profileEditor.hidden = true;
    profileNew.focus();
  });
  profileAdd.addEventListener('click', () => {
    if (profileTotal() >= maxTeam) return;
    const used = new Set(profileEditorRows.map((row) => row.type));
    const type = profileTypes.find((key) => !used.has(key)) ?? profileTypes[0];
    profileEditorRows.push({ type, level: profileLevels[type][0], qty: 1 });
    renderProfileEditor();
  });
  profileSave.addEventListener('click', async () => {
    if (!profileDraft || profileTotal() === 0) return;
    profileDraft.name = profileName.value.trim();
    profileDraft.catpals = profileEditorRows.flatMap((row) =>
      Array.from({ length: row.qty }, (): SavedCatpal => ({
        id: newId(), name: '', catpal_type: row.type, current_level: row.level,
      })),
    );
    profileSave.disabled = true;
    profileSave.textContent = t('profile.saving');
    profileStatus.textContent = t('profile.saving');
    try {
      await profileManager.save(structuredClone(profileDraft));
      profileStatus.textContent = t('profile.saved');
      profileDraft = null;
      profileEditor.hidden = true;
      profileNew.focus();
    } catch {
      profileStatus.textContent = t('error.profile.save_failed');
    } finally {
      profileSave.disabled = false;
      profileSave.textContent = t('profile.save');
    }
  });

  savedTeamsToggle.addEventListener('click', () => {
    const opening = savedTeams.hidden;
    savedTeams.hidden = !opening;
    savedTeamsToggle.setAttribute('aria-expanded', String(opening));
    if (opening) {
      const firstTeam = profileList.querySelector<HTMLButtonElement>('button');
      (firstTeam ?? profileEmpty).focus({ preventScroll: true });
    }
  });
  savedTeams.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    savedTeams.hidden = true;
    savedTeamsToggle.setAttribute('aria-expanded', 'false');
    savedTeamsToggle.focus();
  });

  const profileManager = new ProfileManager();
  profileManager.subscribe((state) => {
    renderProfiles(state.profiles);
    profileStorage.textContent = state.syncing
      ? t('auth.syncing')
      : state.account
        ? t('auth.signed_in_as', { name: state.account.name })
        : t('auth.local_only');
  });
  void profileManager.start();

  /* Editing the form invalidates what is on screen. Leaving a stale table
     exportable is how someone downloads numbers for a team they no longer
     have. */
  function markStale() {
    clearFieldErrors();
    updateTeamSize();
    if (!downloads) return;
    downloads = null;
    for (const element of exportButtons) element.disabled = true;
    status.textContent = t('state.stale');
  }

  for (const input of [...countInputs, jellyInput]) {
    input.addEventListener('input', markStale);
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    clearFieldErrors();

    const { counts, totalJelly } = readForm();
    button.disabled = true;
    status.textContent = t('state.calculating');

    /* Yield one frame before solving. The work is synchronous and blocks the
       main thread, so without this the "Calculating…" label would never paint
       and a slow case would look like a frozen page. */
    requestAnimationFrame(() => setTimeout(() => {
      try {
        const data = solve(counts, totalJelly);

        document.getElementById('total-power')!.textContent = fmt(data.totals.effective_power);
        document.getElementById('total-spent')!.textContent = fmt(data.totals.spent);
        document.getElementById('total-leftover')!.textContent = fmt(data.totals.leftover);
        renderRows(data.rows, data.meta.display_order);

        const reportOptions = { locale: localeTag, translate: t as never };
        showNotice('warning', data.notices.map((n) => t(n.key as never, n.params)));
        status.textContent = data.rows.length ? t('state.done') : t('state.empty');

        downloads = {
          csv: formatCsv(data, reportOptions),
          json: formatJson(data, reportOptions),
        };
        for (const element of exportButtons) element.disabled = false;
      } catch (error) {
        status.textContent = '';
        if (error instanceof ToolError) {
          showNotice('error', [t(error.key as never, error.params)]);
          focusFieldError(error);
        } else {
          showNotice('error', [t('error.unexpected')]);
          throw error;   // a real bug belongs in the console, not swallowed
        }
      } finally {
        button.disabled = false;
      }
    }, 0));
  });

  for (const element of exportButtons) {
    element.addEventListener('click', () => {
      if (!downloads) return;
      const kind = element.dataset.export as 'csv' | 'json';
      const blob = new Blob([downloads[kind]], {
        type: kind === 'csv' ? 'text/csv;charset=utf-8' : 'application/json',
      });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `forneus-amigatos.${kind}`;
      link.click();
      URL.revokeObjectURL(url);
    });
  }

  shareButton.addEventListener('click', async () => {
    const url = new URL(location.href);
    url.hash = `team=${encodeShare(readForm())}`;
    try {
      await navigator.clipboard.writeText(url.href);
      shareStatus.textContent = t('share.copied');
    } catch {
      shareStatus.textContent = url.href;
    }
  });

  loadSharedTeam();
  updateTeamSize();
</script>

