---
/**
 * Sign in, and the account page once signed in.
 *
 * One page for both states rather than a modal: OAuth leaves and comes back
 * via a full navigation, so there has to be a real URL to come back to.
 */
import Site from '../../layouts/Site.astro';
import { useTranslations, LOCALES, type Locale } from '../../i18n/utils';
import { LOCALE_TAG } from '../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
---
<Site locale={locale} title={t('auth.title')} description={t('auth.why')}>
  <div class="wrap" id="account" data-locale={locale} data-locale-tag={LOCALE_TAG[locale]}>

    <section class="card" data-signed-out>
      <h1>{t('auth.title')}</h1>
      <p class="lead">{t('auth.why')}</p>

      <div class="providers">
        <button type="button" class="fx-btn" data-provider="discord">{t('auth.discord')}</button>
        <button type="button" class="fx-btn fx-btn--ghost" data-provider="google">{t('auth.google')}</button>
      </div>

      <p class="hint" data-error hidden role="alert"></p>
      <p class="hint" data-unavailable hidden>{t('error.accounts.unavailable')}</p>
    </section>

    <section class="card" data-signed-in hidden>
      <h1 data-name>—</h1>
      <p class="lead" data-email></p>
      <div class="providers">
        <a class="fx-btn" href={`/${locale}/ferramentas/amigatos/perfil/`}>{t('profile.heading')}</a>
        <button type="button" class="fx-btn fx-btn--ghost" data-signout>{t('nav.signout')}</button>
      </div>
    </section>

  </div>
</Site>

<script>
  import { signInWith, signOut, currentAccount, onAccountChange, accountsEnabled }
    from '../../lib/profiles/auth.ts';
  import { useTranslations, type Locale } from '../../i18n/utils';

  const root = document.getElementById('account')!;
  const t = useTranslations(root.dataset.locale as Locale);
  const $ = <T extends HTMLElement>(name: string) => root.querySelector<T>(`[data-${name}]`)!;

  const signedOut = $('signed-out'), signedIn = $('signed-in');
  const errorEl = $('error');

  if (!accountsEnabled) {
    $('unavailable').hidden = false;
    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-provider]')) {
      button.disabled = true;
    }
  }

  function render(account: Awaited<ReturnType<typeof currentAccount>>) {
    signedOut.hidden = Boolean(account);
    signedIn.hidden = !account;
    if (!account) return;
    $('name').textContent = account.name;
    $('email').textContent = account.email ?? '';
  }

  for (const button of root.querySelectorAll<HTMLButtonElement>('[data-provider]')) {
    button.addEventListener('click', async () => {
      errorEl.hidden = true;
      button.disabled = true;
      // Come back to this page: it is where the signed-in state is shown, and
      // it links on to the teams.
      const result = await signInWith(
        button.dataset.provider as 'discord' | 'google',
        globalThis.location.pathname,
      );
      if (!result.ok) {
        button.disabled = false;
        errorEl.textContent = t(result.key as never);
        errorEl.hidden = false;
      }
      // On success the browser is already navigating away.
    });
  }

  $('signout').addEventListener('click', async () => {
    await signOut();
  });

  onAccountChange(render);
</script>

<style>
  .wrap { display: grid; place-items: center; padding: var(--space-12) var(--page-pad); }
  .card {
    display: flex; flex-direction: column; gap: var(--space-6);
    width: 100%; max-width: 46ch; padding: var(--space-9);
    background: var(--bg-panel); border: var(--border) solid var(--line-hard);
  }
  h1 { font-size: var(--size-display-l); }
  .lead { color: var(--text-muted); }
  .providers { display: flex; flex-direction: column; gap: var(--space-3); }
  .hint { font-size: var(--size-body-s); color: var(--danger); }
</style>
