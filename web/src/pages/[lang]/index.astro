---
import Site from '../../layouts/Site.astro';
import { tools } from '../../data/tools';
import { solve } from '../../lib/solver/index.ts';
import { EXAMPLE_TEAM, EXAMPLE_BUDGET } from '../../data/example-team';
import { groupRows } from '../../lib/rows.ts';
import { useTranslations, formatNumber, LOCALES, type Locale } from '../../i18n/utils';

export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const pt = locale === 'pt';
const n = (value: number) => formatNumber(value, locale);
const copy = pt ? {
  title: 'Sua equipe, seu plano.',
  intro: 'Seu ponto de encontro para planejar Amigatos e Florais em Tree of Savior Neo.',
  action: 'Planejar meus Amigatos', explore: 'Ver ferramentas',
  tools: 'Prepare sua equipe', toolsText: 'Escolha o sistema que você quer organizar.',
  catTitle: 'Quem merece o próximo nível?',
  catText: 'Informe sua equipe e a gelatina disponível. Compare como distribuir seus recursos entre os Amigatos.',
  catAction: 'Abrir planejador', catNote: 'Cálculo de poder com os Amigatos em 6 estrelas.',
  flowerTitle: 'Encontre lugar para cada Floral.',
  flowerText: 'Organize seus guardiões e Spiritus. Compare posições, cultivos e bônus para montar seu jardim.',
  flowerAction: 'Planejar meu jardim', flowerNote: 'Guardiões, Spiritus e combinações R1 / R2.',
  phantomTitle: 'Os Fantasmas chegam depois.',
  phantomText: 'Uma ferramenta para consultar tipos, habilidades e combinações está em preparação.',
  phantomNote: 'Ainda em desenvolvimento.', unavailable: 'Em preparação',
  preview: 'Teste antes de investir', previewText: 'A mesma equipe, três orçamentos. Escolha quanto investir e confira o plano calculado.',
  budget: 'Gelatina de peixe disponível', power: 'Poder efetivo da equipe', level: 'Nível', cat: 'Amigato',
  example: 'Equipe de exemplo com 6 estrelas', full: 'Calcular com minha equipe',
  note: 'O poder efetivo considera as taxas de assistência. Confira sua equipe no planejador antes de usar o resultado.',
  close: 'Seu plano acompanha você.', closeText: 'Guarde seus perfis de equipe e volte quando chegar a hora da próxima evolução.', closeAction: 'Montar minha equipe',
} : {
  title: 'Your team, your plan.',
  intro: 'Your place to plan Catpals and Floral Guardians in Tree of Savior Neo.',
  action: 'Plan my Catpals', explore: 'Explore tools',
  tools: 'Prepare your team', toolsText: 'Choose the system you want to organize.',
  catTitle: 'Who gets the next level?',
  catText: 'Enter your team and available Fish Jelly. Compare how to distribute your resources among your Catpals.',
  catAction: 'Open planner', catNote: 'Power calculations use Catpals at 6 stars.',
  flowerTitle: 'A place for every guardian.',
  flowerText: 'Arrange your guardians and Spiritus. Compare positions, cultivation and bonuses to plan your garden.',
  flowerAction: 'Plan my garden', flowerNote: 'Guardians, Spiritus and R1 / R2 combinations.',
  phantomTitle: 'Phantoms are on their way.',
  phantomText: 'A tool to explore types, skills and combinations is in preparation.',
  phantomNote: 'Still in development.', unavailable: 'In preparation',
  preview: 'Try before you invest', previewText: 'The same team, three budgets. Pick how much to invest and see the calculated plan.',
  budget: 'Available Fish Jelly', power: 'Team effective power', level: 'Level', cat: 'Catpal',
  example: 'Example team at 6 stars', full: 'Calculate for my team',
  note: 'Effective power includes assistance rates. Check your team in the planner before using the result.',
  close: 'Take your plan with you.', closeText: 'Keep your team profiles and return when it is time for the next upgrade.', closeAction: 'Build my team',
};
const toolDetails: Record<string, { icon: string; title: string; text: string; action?: string; note: string }> = {
  amigatos: { icon: '/assets/amigatos/game-cat.png', title: copy.catTitle, text: copy.catText, action: copy.catAction, note: copy.catNote },
  florais: { icon: '/assets/home/flower-icon.webp', title: copy.flowerTitle, text: copy.flowerText, action: copy.flowerAction, note: copy.flowerNote },
  fantasmas: { icon: '/assets/home/pet-icon.webp', title: copy.phantomTitle, text: copy.phantomText, note: copy.phantomNote },
};
const orderedTools = ['amigatos', 'florais', 'fantasmas'].map((name) => tools.find((tool) => tool.name === name)!);
const scenarios = [.5, 1, 1.5].map((ratio) => {
  const budget = Math.round(EXAMPLE_BUDGET * ratio);
  const result = solve(EXAMPLE_TEAM, budget);
  return { budget, power: result.totals.effective_power, rows: groupRows(result.rows, result.meta.display_order) };
});
const portraits = [5100001, 5100002, 5120003, 5120004];
---
<Site locale={locale} title={pt ? 'Planeje sua equipe' : 'Plan your team'} description={copy.intro} bodyClass="game-home">
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Bree+Serif&display=swap" rel="stylesheet" />
  <div class="game-landing">
    <section class="welcome" aria-labelledby="welcome-title">
      <div class="welcome__art"><img src="/assets/home/world-tree.webp" alt={pt ? 'Aventureiros e companheiros descansam sob uma árvore florida de Tree of Savior Neo.' : 'Adventurers and companions resting beneath a flowering tree in Tree of Savior Neo.'} width="2044" height="1363" fetchpriority="high" /></div>
      <div class="welcome__content">
        <h1 id="welcome-title">{copy.title}</h1><p>{copy.intro}</p>
        <a class="game-button" href={`/${locale}/ferramentas/amigatos/`}>{copy.action}</a>
        <a class="text-link" href="#ferramentas">{copy.explore}</a>
      </div>
    </section>
    <section class="workbench" id="ferramentas" aria-labelledby="tools-title">
      <div class="section-heading"><h2 id="tools-title">{copy.tools}</h2><p>{copy.toolsText}</p></div>
      <div class="companion-book" data-tools>
        <div class="book-tabs" role="tablist" aria-label={copy.tools}>
          {orderedTools.map((tool, index) => <button type="button" role="tab" id={`tab-${tool.name}`} aria-controls={`panel-${tool.name}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-tool-tab={tool.name}>
            <img src={toolDetails[tool.name].icon} alt="" width="56" height="56" /><span>{t(tool.navKey)}</span>
          </button>)}
        </div>
        {orderedTools.map((tool, index) => {
          const detail = toolDetails[tool.name];
          return <div class:list={['book-panel', `book-panel--${tool.name}`]} role="tabpanel" id={`panel-${tool.name}`} aria-labelledby={`tab-${tool.name}`} tabindex="0" hidden={index !== 0}>
            <div class="book-panel__copy"><h3>{detail.title}</h3><p>{detail.text}</p>
              {tool.status === 'available' ? <a class="game-button" href={`/${locale}/ferramentas/${tool.name}/`}>{detail.action}</a> : <span class="pending">{copy.unavailable}</span>}
              <small>{detail.note}</small>
            </div>
            <div class="book-panel__picture" aria-hidden="true">
              {tool.name === 'amigatos' && <><img class="book-panel__scene" src="/assets/home/world-tree.webp" width="2044" height="1363" loading="lazy" alt="" /><div class="portrait-tray">{portraits.map((id) => <img src={`/assets/amigatos/portraits/${id}.png`} width="88" height="88" loading="lazy" alt="" />)}</div></>}
              {tool.name === 'florais' && <><img class="book-panel__scene" src="/assets/home/garden.webp" width="1943" height="1000" loading="lazy" alt="" /><div class="guardian-tray">{['strawbie','kumquat','passion-coconut'].map((name) => <img src={`/assets/florais/flowerguards-${name}.png`} width="96" height="96" loading="lazy" alt="" />)}</div></>}
              {tool.name === 'fantasmas' && <img class="book-panel__scene journey" src="/assets/home/journey.webp" width="1302" height="487" loading="lazy" alt="" />}
            </div>
          </div>;
        })}
        <noscript><p class="no-script">{orderedTools.filter((tool) => tool.status === 'available').map((tool) => <a href={`/${locale}/ferramentas/${tool.name}/`}>{t(tool.navKey)}</a>)}</p></noscript>
      </div>
    </section>
    <section class="planning" aria-labelledby="planning-title">
      <div class="planning__copy"><h2 id="planning-title">{copy.preview}</h2><p>{copy.previewText}</p>
        <img class="planning__illustration" src="/assets/home/journey.webp" alt="" width="1302" height="487" loading="lazy" />
        <p class="planning__note">{copy.note}</p>
      </div>
      <div class="plan-sheet" data-sample data-ui>
        <p class="plan-sheet__caption">{copy.example}</p>
        <fieldset><legend>{copy.budget}</legend><div class="budget-choices">{scenarios.map((scenario, index) => <button type="button" aria-pressed={index === 1 ? 'true' : 'false'} data-sample-choice={index}>{n(scenario.budget)}</button>)}</div></fieldset>
        {scenarios.map((scenario, index) => <div data-sample-result={index} hidden={index !== 1} aria-live="polite">
          <div class="team-power"><span>{copy.power}</span><strong>{n(scenario.power)}</strong></div>
          <table><caption class="sr-only">{copy.example}</caption><thead><tr><th scope="col">{copy.cat}</th><th scope="col">{copy.level}</th><th scope="col">{pt ? 'Poder efetivo' : 'Effective power'}</th></tr></thead><tbody>{scenario.rows.map((row) => <tr><th scope="row">{row.display_name}{row.count > 1 && <span> ×{row.count}</span>}</th><td>{row.level}</td><td>{n(row.effective_power)}</td></tr>)}</tbody></table>
        </div>)}
        <a class="game-button" href={`/${locale}/ferramentas/amigatos/`}>{copy.full}</a>
      </div>
    </section>
    <section class="camp" aria-labelledby="camp-title"><img src="/assets/amigatos/game-cat.png" width="98" height="112" loading="lazy" alt="" /><div><h2 id="camp-title">{copy.close}</h2><p>{copy.closeText}</p></div><a class="game-button" href={`/${locale}/ferramentas/amigatos/`}>{copy.closeAction}</a></section>
  </div>
</Site>
<script>
  document.querySelectorAll<HTMLElement>('[data-tools]').forEach((book) => {
    const tabs = [...book.querySelectorAll<HTMLButtonElement>('[data-tool-tab]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((item) => { const active = item === tab; item.setAttribute('aria-selected', String(active)); item.tabIndex = active ? 0 : -1; });
      book.querySelectorAll<HTMLElement>('[role="tabpanel"]').forEach((panel) => { panel.hidden = panel.id !== `panel-${tab.dataset.toolTab}`; });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        let next: number;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault(); select(tabs[next]); tabs[next].focus();
      });
    });
  });
  document.querySelectorAll<HTMLElement>('[data-sample]').forEach((sample) => {
    const buttons = [...sample.querySelectorAll<HTMLButtonElement>('[data-sample-choice]')];
    buttons.forEach((button) => button.addEventListener('click', () => {
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      sample.querySelectorAll<HTMLElement>('[data-sample-result]').forEach((result) => { result.hidden = result.dataset.sampleResult !== button.dataset.sampleChoice; });
    }));
  });
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('arrived');
        observer.unobserve(entry.target);
      });
    }, { threshold: .08 });
    document.querySelectorAll('.welcome__content > *, .section-heading, .book-tabs, .planning__copy > h2, .planning__copy > p, .plan-sheet, .camp').forEach((element) => observer.observe(element));
  }
</script>
<style>
  :global(body.game-home) { --home-ground:#e9ecd9; --home-paper:#f6efd9; --home-paper-deep:#e4d6b5; --home-ink:#443e2d; --home-muted:#615b45; --home-green:#3f6249; --home-green-hover:#304e39; --home-gold:#e0bd76; --home-light:#fff9e9; --home-heading:'Bree Serif',Georgia,serif; --focus-ring:3px solid #345f49; --focus-offset:5px; background:var(--home-ground); color:var(--home-ink); color-scheme:light; }
  :global(.game-home .page) { max-width:none; }
  :global(body.game-home .hdr) { background:var(--home-paper); color:var(--home-ink); }
  :global(body.game-home .hdr .hdr__inner) { max-width:1320px; min-height:82px; padding-inline:40px; }
  :global(body.game-home .hdr .brandmark) { color:var(--home-ink); letter-spacing:.03em; }
  :global(body.game-home .hdr .hdr__brand .brandmark) { font-size:32px; }
  :global(body.game-home .hdr .brandmark svg) { color:var(--home-green); }
  :global(body.game-home .hdr .hdr__link),:global(body.game-home .hdr .hdr__locale) { color:var(--home-muted); font-size:16px; }
  :global(body.game-home .hdr .hdr__locale.is-active),:global(body.game-home .hdr .hdr__link:hover) { color:var(--home-green); }
  :global(body.game-home .hdr .hdr__beta) { border:0; color:var(--home-green); font-size:16px; }
  :global(body.game-home .hdr .hdr__menu span) { background:var(--home-ink); }
  :global(body.game-home .hdr .acct__link),:global(body.game-home .hdr .acct__user) { color:var(--home-green); font-size:16px; min-height:44px; }
  :global(body.game-home .ftr) { background:var(--home-green); }
  :global(body.game-home .ftr::before),:global(body.game-home .ftr::after) { display:none; }
  :global(body.game-home .ftr .ftr__inner) { max-width:1240px; padding-block:60px 45px; }
  :global(body.game-home .ftr .ftr__bottom) { max-width:none; padding-inline:max(24px,calc((100vw - 1192px)/2)); background:var(--home-green-hover); }
  :global(body.game-home .ftr .brandmark svg) { color:var(--home-gold); }
  :global(body.game-home .ftr .ftr__links a span) { display:none; }
  :global(body.game-home .ftr .ftr__about .brandmark) { font-size:44px; }
  :global(body.game-home .ftr .ftr__about p),:global(body.game-home .ftr .ftr__links a) { font-size:18px; }
  :global(body.game-home .ftr .ftr__links h2) { font-size:32px; }
  :global(body.game-home .ftr .ftr__about small),:global(body.game-home .ftr .ftr__links p),:global(body.game-home .ftr .ftr__bottom) { font-size:16px; }
  .game-landing { font:400 18px/1.55 var(--font-body); color:var(--home-ink); }
  .game-landing :is(h1,h2,h3) { color:var(--home-ink); font-family:var(--home-heading); font-weight:400; letter-spacing:-.025em; text-transform:none; text-wrap:balance; }
  .game-landing h2 { font-size:clamp(32px,3.4vw,44px); line-height:1.15; }
  .game-landing p { max-width:49ch; }
  .game-landing a { text-decoration:none; }
  .game-button { display:inline-flex; justify-content:center; align-items:center; min-height:52px; padding:12px 25px; background:var(--home-green); color:var(--home-light); font-size:18px; font-weight:600; border-radius:5px 5px 14px 5px; transition:background .18s,transform .18s; }
  .game-button:hover { background:var(--home-green-hover); color:var(--home-light); transform:translateY(-2px); }
  .game-button:active { transform:translateY(1px); }
  .text-link { display:inline-flex; align-items:center; min-height:44px; color:var(--home-green); font-weight:600; text-underline-offset:5px; }
  .text-link:hover { color:var(--home-green-hover); text-decoration:underline; }
  .welcome { position:relative; isolation:isolate; min-height:610px; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.2fr); align-items:stretch; overflow:hidden; background:var(--home-paper); }
  .welcome__content { grid-column:1; grid-row:1; align-self:center; min-width:0; padding:72px 48px 72px max(40px,calc((100vw - 1160px)/2)); }
  .welcome h1 { max-width:11ch; font-size:clamp(64px,6.4vw,88px); line-height:1.02; }
  .welcome__content p { max-width:30ch; margin:25px 0 28px; font-size:18px; line-height:1.5; }
  .welcome__content .text-link { display:flex; width:fit-content; margin-top:14px; }
  .welcome__art { grid-column:2; grid-row:1; position:relative; min-width:0; overflow:hidden; background:var(--home-ground); }
  .welcome__art img { position:absolute; inset:0; display:block; width:100%; height:100%; object-fit:cover; object-position:52% 50%; }
  .workbench { max-width:1240px; padding:72px 40px 92px; margin:auto; scroll-margin-top:24px; }
  .section-heading { display:flex; align-items:baseline; justify-content:space-between; gap:20px; margin-bottom:32px; }
  .section-heading p { color:var(--home-muted); }
  .companion-book { position:relative; }
  .book-tabs { display:flex; align-items:end; gap:8px; padding-left:16px; }
  .book-tabs button { display:flex; align-items:center; gap:10px; min-height:74px; padding:8px 30px 10px 16px; border:0; border-radius:14px 14px 0 0; font:600 18px var(--font-body); color:var(--home-muted); background:var(--home-paper-deep); cursor:pointer; transition:background .2s,transform .2s; }
  .book-tabs button[aria-selected='true'] { background:var(--home-paper); color:var(--home-green); }
  .book-tabs button:hover { color:var(--home-green); transform:translateY(-3px); }
  .book-tabs img { width:48px; height:48px; object-fit:contain; transition:transform .2s; }
  .book-tabs button:hover img { transform:rotate(-7deg); }
  .book-panel { display:grid; grid-template-columns:1fr 1.05fr; min-height:390px; background:var(--home-paper); border-radius:12px 20px 20px 12px; overflow:hidden; }
  .book-panel__copy { padding:42px 40px; display:flex; flex-direction:column; align-items:start; }
  .book-panel h3 { max-width:21ch; font-size:32px; line-height:1.15; }
  .book-panel p { margin:18px 0 26px; }
  .book-panel small { display:block; max-width:39ch; margin-top:18px; font-size:16px; color:var(--home-muted); }
  .book-panel__picture { position:relative; min-width:0; overflow:hidden; }
  .book-panel__scene { display:block; height:100%; width:100%; object-fit:cover; object-position:52% 60%; }
  .book-panel--florais .book-panel__scene { object-position:65% center; }
  .portrait-tray,.guardian-tray { position:absolute; bottom:28px; left:0; right:0; display:flex; justify-content:center; gap:10px; }
  .portrait-tray img { width:76px; height:76px; object-fit:contain; background:var(--home-paper); border-radius:12px; padding:4px; transition:transform .2s; }
  .portrait-tray img:hover,.guardian-tray img:hover { transform:translateY(-7px); }
  .guardian-tray img { width:86px; height:86px; object-fit:contain; transition:transform .2s; }
  .book-panel--fantasmas .book-panel__picture { display:flex; align-items:center; background:var(--home-ground); }
  .book-panel .journey { height:auto; object-fit:contain; }
  .pending { padding:12px 20px; background:var(--home-paper-deep); border-radius:5px; font-size:18px; font-weight:600; }
  .no-script { padding:20px; background:var(--home-paper); }
  .no-script a { color:var(--home-green); margin-right:20px; text-decoration:underline; }
  .planning { display:grid; grid-template-columns:1fr 1fr; align-items:start; gap:70px; max-width:1240px; margin:auto; padding:0 40px 90px; }
  .planning__copy { padding-top:30px; }
  .planning__copy>p { margin-top:22px; }
  .planning__illustration { display:block; width:100%; height:auto; margin:40px 0 0; }
  .planning .planning__note { max-width:47ch; color:var(--home-muted); font-size:16px; margin-top:26px; }
  .plan-sheet { background:var(--home-paper); padding:30px 32px 34px; border-radius:16px 16px 28px 5px; font-size:16px; }
  .plan-sheet__caption { margin-bottom:22px; color:var(--home-muted); }
  .plan-sheet fieldset { padding:0; margin:0; border:0; min-width:0; }
  .plan-sheet legend { padding:0; margin-bottom:12px; font-weight:600; }
  .budget-choices { display:flex; gap:8px; }
  .budget-choices button { flex:1; min-height:44px; padding:8px; border:2px solid var(--home-paper-deep); border-radius:5px; font:600 16px var(--font-body); font-variant-numeric:tabular-nums; background:var(--home-light); color:var(--home-ink); cursor:pointer; transition:background .2s,transform .2s; }
  .budget-choices button[aria-pressed='true'] { background:var(--home-green); color:var(--home-light); border-color:var(--home-green); }
  .budget-choices button:hover { transform:translateY(-2px); }
  .team-power { display:flex; flex-direction:column; padding:22px 0 16px; color:var(--home-green); }
  .team-power strong { font-size:44px; line-height:1.2; font-variant-numeric:tabular-nums; font-weight:600; }
  .plan-sheet table { width:100%; border-collapse:collapse; font-size:16px; font-variant-numeric:tabular-nums; }
  .plan-sheet th,.plan-sheet td { padding:9px 7px; text-align:right; border-bottom:1px solid var(--home-paper-deep); }
  .plan-sheet th:first-child { text-align:left; padding-left:0; }
  .plan-sheet thead th { font-weight:500; color:var(--home-muted); }
  .plan-sheet tbody th { font-weight:600; }
  .plan-sheet tbody th span { font-weight:400; }
  .plan-sheet .game-button { width:100%; margin-top:24px; }
  .camp { display:flex; gap:25px; align-items:center; max-width:1160px; margin:0 auto 75px; padding:30px 35px; background:var(--home-paper-deep); border-radius:16px; }
  .camp>img { width:78px; height:90px; object-fit:contain; flex:none; }
  .camp h2 { font-size:32px; }
  .camp p { margin-top:8px; max-width:47ch; font-size:18px; }
  .camp .game-button { flex:none; margin-left:auto; }
  .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
  @media (prefers-reduced-motion:no-preference) {
    .arrived { animation:settle-in .45s ease-out both; }
    .welcome__content p.arrived { animation-delay:60ms; }
    .welcome__content .game-button.arrived { animation-delay:120ms; }
    .welcome__content .text-link.arrived { animation-delay:180ms; }
    .welcome__art img { animation:tree-breath 22s ease-in-out infinite alternate; }
    .book-panel:not([hidden]) .book-panel__picture { animation:page-open .35s ease-out; }
    [data-sample-result]:not([hidden]) .team-power { animation:page-open .2s ease-out; }
    @keyframes tree-breath { to { transform:scale(1.035); } }
    @keyframes page-open { from { opacity:.35; transform:translateY(5px); } to { opacity:1; transform:none; } }
    @keyframes settle-in { from { opacity:.5; transform:translateY(8px); } to { opacity:1; transform:none; } }
  }
  @media (max-width:1000px) {
