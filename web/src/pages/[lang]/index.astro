---
import Site from '../../layouts/Site.astro';
import AnimatedMenu from '../../components/AnimatedMenu.astro';
import { tools } from '../../data/tools';
import { useTranslations, LOCALES, type Locale } from '../../i18n/utils';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const title = locale === 'pt' ? 'Ferramentas pessoais' : 'Personal tools';
const description = locale === 'pt'
  ? 'Acesse as ferramentas pessoais da Forneus.'
  : 'Open Forneus personal tools.';
const items = [
  { label: 'Home', href: `/${locale}/`, current: true },
  ...tools.map((tool) => ({
    label: t(tool.navKey),
    href: tool.status === 'available' ? `/${locale}/ferramentas/${tool.name}/` : undefined,
  })),
];
---

<Site locale={locale} title={title} description={description} bodyClass="hub-home">
  <AnimatedMenu items={items} label={locale === 'pt' ? 'Menu principal' : 'Main menu'} />
</Site>

<style>
  :global(body.hub-home) {
    display: flex;
    min-height: 100vh;
    min-height: 100svh;
    flex-direction: column;
    background: #101114;
    color: #f5f5f6;
    color-scheme: dark;
  }

  :global(.hub-home .page) {
    display: flex;
    width: 100%;
    max-width: none;
    flex: 1;
    align-items: stretch;
  }
</style>
